# Self-hosted Zylith renewal relayer.
# Copy to an untracked env file, fill the values, and run the relayer process.

ZYLITH_RENEWAL_RELAY_STRICT=true
ZYLITH_RENEWAL_RELAY_ACCEPT_RELAY_MODE=SelfRelay
ZYLITH_RENEWAL_RELAY_BIND_ADDR=127.0.0.1:3400
ZYLITH_RENEWAL_RELAY_STORE_PATH=/var/lib/zylith-renewal-relayer/relay.sqlite

# Pin the services this relay may submit to.
ZYLITH_RENEWAL_RELAY_COORDINATOR_URL=https://api.zylith.fi
ZYLITH_RENEWAL_RELAY_PROVER_URL=https://api.zylith.fi
# Optional ordered failover sets. If set, these override the single URL vars.
# ZYLITH_RENEWAL_RELAY_COORDINATOR_URLS=https://api.zylith.fi,https://api-backup.zylith.fi
# ZYLITH_RENEWAL_RELAY_PROVER_URLS=https://api.zylith.fi,https://api-backup.zylith.fi

# Used for internal tick authorization. Keep this private.
ZYLITH_RENEWAL_RELAY_INTERNAL_TOKEN=replace-with-long-random-token

# Used to read exact no-fill/matched reuse_state from the prover before
# submitting a later slot that reuses maker funding notes.
ZYLITH_RENEWAL_RELAY_PROVER_CONTROL_TOKEN=replace-with-prover-proof-status-token

# Optional. Only Zylith-operated or explicitly authorized relays should set this;
# self-hosted maker relays normally submit through the public order route.
# ZYLITH_RENEWAL_RELAY_COORDINATOR_CONTROL_TOKEN=replace-with-managed-token

# Browser origins allowed to register packages.
ZYLITH_RENEWAL_RELAY_ALLOWED_ORIGINS=https://app.zylith.fi

# Operational defaults.
ZYLITH_RENEWAL_RELAY_ENABLE_WORKER=true
ZYLITH_RENEWAL_RELAY_TICK_MS=5000
ZYLITH_RENEWAL_RELAY_MAX_PACKAGE_SLOTS=100000
ZYLITH_RENEWAL_RELAY_RETRY_BACKOFF_MS=8000
ZYLITH_RENEWAL_RELAY_MAX_ATTEMPTS=16
ZYLITH_RENEWAL_RELAY_MAX_BODY_BYTES=67108864
ZYLITH_RENEWAL_RELAY_PACKAGE_RETENTION_MS=10368000000
ZYLITH_RENEWAL_RELAY_RATE_LIMIT_PER_MINUTE=120
ZYLITH_RENEWAL_RELAY_PACKAGE_EXPIRY_WARNING_EPOCHS=960

# Optional local alert delivery for Discord/Telegram/email bridges or a maker webhook.
# ZYLITH_RENEWAL_RELAY_ALERT_WEBHOOK_URLS=https://alerts.example.com/zylith-renewals
# ZYLITH_RENEWAL_RELAY_ALERT_WEBHOOK_TOKEN=replace-with-webhook-token
# ZYLITH_RENEWAL_RELAY_ALERT_REPEAT_MS=900000
