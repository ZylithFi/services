# every production dependency has an explicit probe endpoint.
ZYLITH_DEPLOYMENT_MANIFEST=/etc/zylith/deployment.json
ZYLITH_OPERATOR_URL=http://127.0.0.1:3200
ZYLITH_ACTIVE_EXECUTION_KEY_ID=
ZYLITH_REFERENCE_PRICE_ATTESTOR_URL=http://127.0.0.1:8790
ZYLITH_INDEXER_URL=http://127.0.0.1:3300
ZYLITH_COORDINATOR_URL=http://127.0.0.1:3000
ZYLITH_MARKET_DATA_URL=http://127.0.0.1:3500
ZYLITH_CONTROL_PLANE_TOKEN=
ZYLITH_PAYMASTER_HEALTH_URL=http://127.0.0.1:8787/health
ZYLITH_PRIVACY_DISCOVERY_HEALTH_URL=https://api.zylith.fi/starknet-privacy-discovery/health
ZYLITH_PRIVACY_PROVER_HEALTH_URL=https://api.zylith.fi/starknet-privacy-prover/health
ZYLITH_PROOF_QUEUE_HEALTH_URL=http://127.0.0.1:3000/internal/proof-queue/health
ZYLITH_PROOF_QUEUE_MONITOR_TOKEN=
# read-only pre-cutover inventory endpoints; the collector first invokes the authenticated sync.
ZYLITH_OPERATOR_MIGRATION_INVENTORY_URL=http://127.0.0.1:3200/api/internal/status
ZYLITH_INDEXER_SYNC_URL=http://127.0.0.1:3300/api/internal/sync
ZYLITH_INDEXER_MIGRATION_INVENTORY_URL=http://127.0.0.1:3300/api/internal/migration-inventory
ZYLITH_COORDINATOR_MIGRATION_INVENTORY_URL=http://127.0.0.1:3000/internal/migration-inventory
ZYLITH_PROOF_JOB_MAX_ATTEMPTS=3
ZYLITH_PROOF_JOB_RETRY_BACKOFF_MS=5000
# required only when zylith_route_service_url is set.
ZYLITH_ROUTE_SERVICE_HEALTH_URL=
ZYLITH_MONITORING_MAX_INDEXER_LAG_MS=60000
ZYLITH_MONITORING_MAX_INDEXER_SEQ_LAG=1
ZYLITH_MONITORING_MAX_PROOF_PENDING_MS=120000
