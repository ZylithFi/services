ZYLITH_COORDINATOR_BIND_ADDR=127.0.0.1:3000
ZYLITH_COORDINATOR_ALLOWED_ORIGINS=https://app.zylith.fi
ZYLITH_COORDINATOR_RECOVERY_PATH=/var/lib/zylith/coordinator/recovery.sqlite
ZYLITH_TRUSTED_PROXY_CIDRS=127.0.0.1/32
ZYLITH_PROOF_QUEUE_DATABASE_PATH=/var/lib/zylith/coordinator/control-plane.sqlite
ZYLITH_PROOF_ARTIFACT_DIRECTORY=/var/lib/zylith/coordinator/proof-artifacts
ZYLITH_PROOF_ARTIFACT_KEY_HEX=
ZYLITH_PROOF_QUEUE_CONTROL_TOKEN=
ZYLITH_PROOF_QUEUE_MONITOR_TOKEN=
ZYLITH_PROOF_WORKER_GRANT_TTL_MS=300000
ZYLITH_PROOF_WORKER_SESSION_TTL_MS=1800000
ZYLITH_PROOF_WORKER_MAX_LIFETIME_MS=14400000
ZYLITH_PROOF_JOB_LEASE_MS=60000
# only transport/service loss is retried; deterministic failures enter a terminal state at once.
ZYLITH_PROOF_JOB_MAX_ATTEMPTS=3
ZYLITH_PROOF_JOB_RETRY_BACKOFF_MS=5000
ZYLITH_PROOF_JOB_MAX_REQUEST_BYTES=67108864
ZYLITH_PROOF_JOB_COMPLETED_RETENTION_MS=3600000
ZYLITH_PROOF_JOB_ABANDONED_RETENTION_MS=604800000
ZYLITH_PROOF_JOB_CLEANUP_INTERVAL_MS=60000
