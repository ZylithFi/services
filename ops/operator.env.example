# the operator: secrets come from the host's secret store, never from this file.
ZYLITH_DEPLOYMENT_MANIFEST=/etc/zylith/deployment.json
ZYLITH_STARKNET_RPC_URL=https://rpc.example.invalid
ZYLITH_OPERATOR_BIND_ADDR=127.0.0.1:3200
ZYLITH_OPERATOR_ALLOWED_ORIGINS=https://app.zylith.fi
ZYLITH_TRUSTED_PROXY_CIDRS=127.0.0.1/32
ZYLITH_OPERATOR_DATA_DIR=/var/lib/zylith/operator
# a second volume: the operator restores from it when the primary state is lost.
ZYLITH_OPERATOR_REPLICA_DIR=/var/lib/zylith/operator-replica
ZYLITH_OPERATOR_DATA_KEY_HEX=
ZYLITH_CONTROL_PLANE_TOKEN=
ZYLITH_STARKNET_ACCOUNT_ADDRESS=
ZYLITH_STARKNET_PRIVATE_KEY=
ZYLITH_PROOF_ACCOUNT_ADDRESS=
ZYLITH_PROOF_ACCOUNT_PRIVATE_KEY=
ZYLITH_FEE_NOTE_KEY=
# create this file offline with:
# zylith-operator generate-execution-key <canonical-key-id> /etc/zylith/execution-keys.json
# unix only: the command refuses existing files, writes mode 0600, and prints only the public
# registry and pin after durable success. on failure, remove any reported zero-length tombstone;
# a scrub-failure warning requires secure operator intervention.
ZYLITH_EXECUTION_KEYS_PATH=/etc/zylith/execution-keys.json
# the sole key id published by /api/public/execution-keys; the file may also hold one overlap key.
ZYLITH_ACTIVE_EXECUTION_KEY_ID=
ZYLITH_REFERENCE_PRICE_ATTESTOR_URL=http://127.0.0.1:8790
ZYLITH_REFERENCE_PRICE_ATTESTOR_TOKEN=
# the operator writes immutable proof jobs to the control-plane queue; workers never call it.
ZYLITH_PROOF_QUEUE_URL=http://127.0.0.1:3000
ZYLITH_PROOF_QUEUE_CONTROL_TOKEN=
ZYLITH_PROVER_BUILD_ID=stwo-production-v1
# Generated only from successful full SNIP-36 release benchmarks; startup rejects missing,
# stale, malformed, or class-hash-mismatched profiles.
ZYLITH_PROOF_CAPACITY_PROFILE_DIR=/etc/zylith/proof-capacity
ZYLITH_PROOF_JOB_TIMEOUT_SECONDS=120
# external matching: off until a pair enables it in the manifest; then the quoter, a positive
# margin for each routed pair's quote asset (json of asset to atoms) and a price headroom are
# required and this flag must be unset.
ZYLITH_EXTERNAL_MATCHING_DISABLED=1
ZYLITH_SEARCHER_HEADROOM_BPS=5
# a leg's l2 gas: a fixed router cost plus its swaps by route shape (or ekubo's estimate).
ZYLITH_EXTERNAL_LEG_GAS=25000000
ZYLITH_EXTERNAL_LEG_SPLIT_GAS=6000000
ZYLITH_EXTERNAL_LEG_HOP_GAS=8000000
ZYLITH_EPOCH_MS=6000
ZYLITH_EPOCH_PREPARE_MS=3000
ZYLITH_PIPELINE_DEPTH=2
ZYLITH_STEP_BUDGET=700000
ZYLITH_CONFIRMATION_BLOCKS=2
ZYLITH_FEE_COVER_PERCENT=100
# the least a transition's fees must be worth, in strk atoms, and the haircut on the rates that
# value fee notes in other assets.
ZYLITH_MIN_TRANSITION_FEE_STRK=
ZYLITH_FEE_RATE_HAIRCUT_BPS=100
ZYLITH_FORCE_AFTER_MS=60000
