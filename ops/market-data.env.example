ZYLITH_MARKET_DATA_BIND_ADDR=127.0.0.1:3500
# the enabled product pairs are loaded from this canonical manifest.
ZYLITH_DEPLOYMENT_MANIFEST=/etc/zylith/deployment.json
# optional assertion only; when set it must exactly match the manifest.
ZYLITH_MARKET_DATA_PAIRS=STRK/USDC,ETH/USDC
ZYLITH_MARKET_DATA_MAX_STREAMS=4096
ZYLITH_MARKET_DATA_MAX_STREAMS_PER_CLIENT=64
ZYLITH_MARKET_DATA_MAX_STREAM_LIFETIME_SECONDS=300
ZYLITH_TRUSTED_PROXY_CIDRS=127.0.0.1/32
